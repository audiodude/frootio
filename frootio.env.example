# Copy to frootio.env (gitignored); run.sh loads it if present.
# Any of these can instead come from the process environment.

# fal.ai key (image/video generation)
FAL_KEY=
# OpenRouter key (script splitting / LLM steps)
OPENROUTER_API_KEY=

# Optional overrides
# FROOTIO_MEDIA_ROOT=~/frootio/media
# FROOTIO_HOST=127.0.0.1
# FROOTIO_PORT=8770
# FROOTIO_OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
